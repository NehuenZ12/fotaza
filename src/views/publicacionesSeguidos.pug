extends layouts/main

block content

    h2 Publicaciones de usuarios que sigo

    if publicaciones.length === 0

        p No sigues a ningún usuario o aún no tienen publicaciones.

    else

        each publicacion in publicaciones

            .card.mb-4

                .card-body

                    -
                        const imagen =
                            imagenes.find(
                                img =>
                                    img.publicacionId ===
                                    publicacion.id
                            )

                    -
                        const autor =
                            usuarios.find(
                                u => u.id === publicacion.usuarioId
                            )

                    p.text-muted.mb-1

                        strong 👤

                        |  #{autor ? autor.nombre : 'Usuario'}

                    h5.card-title= publicacion.titulo

                    p.card-text= publicacion.descripcion

                    if imagen

                        img.publicacion-seguido-img.mb-3(
                            src=imagen.ruta.startsWith('http')
                                ? imagen.ruta
                                : '/uploads/' + imagen.ruta
                            alt='Imagen'
                        )

                    .mt-3

                        a.btn.btn-info.btn-sm.me-2(
                            href='/intereses/' + publicacion.id
                        )

                            img(
                                src='/img/corazon.png'
                                alt='Interés'
                                class='icono-boton'
                            )

                            | Me interesa

                        details.d-inline-block

                            summary.btn.btn-outline-primary.btn-sm
                                | 💬 Comentarios

                            .mt-3

                                form(
                                    action='/comentarios/crear/' + publicacion.id
                                    method='POST'
                                )

                                    .mb-2

                                        textarea.form-control(
                                            name='texto'
                                            rows='1'
                                            placeholder='Escribe un comentario'
                                            required
                                        )

                                    button.btn.btn-primary.btn-sm(
                                        type='submit'
                                    )
                                        | Comentar

                                hr

                                h6 Comentarios

                                each comentario in comentarios

                                    if comentario.publicacionId === publicacion.id

                                        -
                                            const usuarioComentario =
                                                usuarios.find(
                                                    u => u.id === comentario.usuarioId
                                                )

                                        .border.rounded.p-2.mb-2.bg-light

                                            p.mb-1

                                                strong= usuarioComentario ? usuarioComentario.nombre : 'Usuario'

                                            p.mb-0= comentario.texto