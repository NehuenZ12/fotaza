extends layouts/main

block content

    h2 Publicaciones de usuarios que sigo

    if publicaciones.length === 0

        p No sigues a ningún usuario o aún no tienen publicaciones.

    else

        each publicacion in publicaciones

            .card.mb-4

                .card-body

                    -
                        const imagen =
                            imagenes.find(
                                img =>
                                    img.publicacionId ===
                                    publicacion.id
                            )

                    h5.card-title= publicacion.titulo

                    p.card-text= publicacion.descripcion

                    if imagen

                        img.publicacion-seguido-img.mb-3(
                            src='/uploads/' + imagen.ruta
                            alt='Imagen'
                        )

                    .mt-3

                        a.btn.btn-info.btn-sm.me-2(
                            href='/intereses/' + publicacion.id
                        )

                            img(
                                src='/img/corazon.png'
                                alt='Interés'
                                class='icono-boton'
                            )

                            | Me interesa

                        details.d-inline-block

                            summary.btn.btn-outline-primary.btn-sm
                                | 💬 Comentarios

                            .mt-2

                                p.text-muted
                                    | Próximamente comentarios aquí
