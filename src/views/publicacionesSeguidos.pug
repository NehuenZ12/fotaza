extends layouts/main

block content

    h2 Publicaciones de usuarios que sigo

    if publicaciones.length === 0

        p No sigues a ningún usuario o aún no tienen publicaciones.

    else

        each publicacion in publicaciones

            .card.mb-4

                .card-body

                    -
                        const imagen =
                            imagenes.find(
                                img =>
                                    img.publicacionId ===
                                    publicacion.id
                            )

                    if imagen

                        img.img-fluid.mb-3(
                            src='/uploads/' + imagen.ruta
                            alt='Imagen'
                        )

                    h5.card-title= publicacion.titulo

                    p.card-text= publicacion.descripcion