extends layouts/main

block content

    h2 Nueva publicación

    form(action="/publicaciones/crear" method="POST")

        .mb-3
            label.form-label Título

            input.form-control(
                type="text"
                name="titulo"
                required
            )

        .mb-3
            label.form-label Descripción

            textarea.form-control(
                name="descripcion"
                rows="4"
            )

        button.btn.btn-success(type="submit")
            | Publicar