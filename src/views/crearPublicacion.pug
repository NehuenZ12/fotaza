extends layouts/main

block content

    h2 Nueva publicación

    form(
        action="/publicaciones/crear"
        method="POST"
        enctype="multipart/form-data"
    )

        .mb-3
            label.form-label Título

            input.form-control(
                type="text"
                name="titulo"
                required
            )

        .mb-3
            label.form-label Descripción

            textarea.form-control(
                name="descripcion"
                rows="4"
            )

        .mb-3
            label.form-label Etiquetas

            input.form-control(
                type="text"
                name="etiquetas"
                placeholder="paisaje,naturaleza,viajes"
            )

        .mb-3
            label.form-label Imágenes

            input.form-control(
                type="file"
                name="imagenes"
                accept="image/*"
                multiple
                required
            )

        button.btn.btn-success(type="submit")
            | Publicar