extends layouts/main

block content

    h2 Usuarios

    each usuario in usuarios

        if usuario.id !== usuarioLogueado

            .card.mb-3

                .card-body

                    h5.card-title= usuario.nombre

                    p.card-text= usuario.email

                    a.btn.btn-primary.me-2(
                        href='/usuarios/' + usuario.id
                    )
                        | Ver perfil

                    a.btn.btn-success.me-2(
                        href='/seguir/' + usuario.id
                    )
                        | Seguir

                    a.btn.btn-secondary.me-2(
                        href='/seguir/dejar/' + usuario.id
                    )
                        | Dejar de seguir

                    form(
                        action='/mensajes/enviar/' + usuario.id
                        method='POST'
                        style='display:inline'
                    )

                        input(
                            type='hidden'
                            name='texto'
                            value='Hola, me gustaría contactarme contigo.'
                        )

                        button.btn.btn-warning(
                            type='submit'
                        )
                            | Enviar mensaje