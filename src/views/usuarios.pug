extends layouts/main

block content

    h2 Usuarios

    each usuario in usuarios

        if usuario.id !== usuarioLogueado

            .card.mb-3

                .card-body.text-center

                    img.avatar(
                        src='/img/avatar.png'
                        alt='Avatar'
                    )

                    h5.card-title
                        = usuario.nombre

                    p.card-text
                        = usuario.email

                    .mt-3

                        a.btn.btn-primary.me-2.mb-2(
                            href='/usuarios/' + usuario.id
                        )
                            | Ver perfil

                        a.btn.btn-success.me-2.mb-2(
                            href='/seguir/' + usuario.id
                        )
                            | Seguir

                        a.btn.btn-secondary.me-2.mb-2(
                            href='/seguir/dejar/' + usuario.id
                        )
                            | Dejar de seguir

                        a.btn.btn-warning.mb-2(
                            href='/mensajes/chat/' + usuario.id
                        )
                            | Enviar mensaje