extends layouts/main

block content

    .chat-contenedor

        h2
            | Chat con #{usuarioDestino.nombre}

        hr

        form(
            action='/mensajes/enviar/' + usuarioDestino.id
            method='POST'
        )

            .mb-3

                textarea.form-control(
                    name='texto'
                    rows='3'
                    placeholder='Escribe un mensaje'
                    required
                )

            button.btn.btn-primary(
                type='submit'
            )
                | Enviar mensaje

        hr

        if mensajes.length === 0

            p No hay mensajes todavía.

        else

            each mensaje in mensajes

                if mensaje.remitenteId === usuarioId

                    .text-end.mb-2

                        .mensaje-propio

                            p.mb-0= mensaje.texto

                else

                    .text-start.mb-2

                        .mensaje-ajeno

                            p.mb-0= mensaje.texto