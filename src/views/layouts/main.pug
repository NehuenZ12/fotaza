doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title Fotaza

        link(
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet"
        )

        link(
            rel="stylesheet"
            href="/css/style.css"
)

    body

        nav.navbar.navbar-expand-lg.navbar-dark.bg-dark

            .container

                a.navbar-brand(href="/")
                    | Fotaza

                if usuarioId

                    .navbar-nav.me-auto

                        a.nav-link.text-white(
                            href="/publicaciones"
                        )
                            | Publicaciones

                        a.nav-link.text-white(
                            href="/usuarios"
                        )
                            | Usuarios

                        a.nav-link.text-white(
                            href="/seguir/publicaciones"
                        )
                            | Seguidos

                        a.nav-link.text-white(
                            href="/mensajes"
                        )
                            | Mensajes

                        a.nav-link.text-white(
                            href="/notificaciones"
                        )
                            | Notificaciones

                        a.nav-link.text-white(
                            href="/colecciones"
                        )
                            | Colecciones

                        if usuarioRol === 'VALIDADOR'

                            a.nav-link.text-warning(
                                href="/validador"
                            )
                                | Validador

                        a.nav-link.text-white(
                            href="/perfil"
                        )
                            | Perfil

                        a.nav-link.text-danger(
                            href="/auth/logout"
                        )
                            | Salir


        .container.mt-4

            block content