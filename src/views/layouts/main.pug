doctype html
html(lang="es")

    head

        meta(charset="UTF-8")

        meta(
            name="viewport"
            content="width=device-width, initial-scale=1.0"
        )

        title Fotaza

        link(
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet"
        )

        link(
            rel="stylesheet"
            href="/css/style.css"
        )

    body

        .sidebar

            .logo

                a(href="/")
                    | Fotaza

            if usuarioId

                a.menu-item(
                    href="/publicaciones"
                )
                    span Publicaciones

                a.menu-item(
                    href="/usuarios"
                )
                    span Usuarios

                a.menu-item(
                    href="/seguir/publicaciones"
                )
                    span Seguidos

                a.menu-item(
                    href="/mensajes"
                )
                    span Mensajes

                a.menu-item(
                    href="/notificaciones"
                )
                    span Notificaciones

                a.menu-item(
                    href="/colecciones"
                )
                    span Colecciones

                if usuarioRol === 'VALIDADOR'

                    a.menu-item(
                        href="/validador"
                    )
                        span Validador

                a.menu-item(
                    href="/perfil"
                )
                    span Perfil

                a.menu-item.salir(
                    href="/auth/logout"
                )
                    span Salir

        .main-content

            .container-fluid.p-4

                block content