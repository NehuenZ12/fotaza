extends layouts/main

block content

    h2 Notificaciones

    if notificaciones.length === 0

        p No tienes notificaciones.

    else

        each notificacion in notificaciones

            .card.mb-2

                .card-body

                    p.mb-2.fw-semibold

                        if notificacion.mensaje.includes('valoró')

                            | ⭐ #{notificacion.mensaje}

                        else if notificacion.mensaje.includes('comentó')

                            | 💬 #{notificacion.mensaje}

                        else if notificacion.mensaje.includes('comenzó a seguirte')

                            | 👤 #{notificacion.mensaje}

                        else if notificacion.mensaje.includes('interesa')

                            | ❤️ #{notificacion.mensaje}

                        else

                            = notificacion.mensaje

                    .d-flex.justify-content-between.align-items-center.flex-wrap

                        small.text-muted
                            = notificacion.createdAt.toLocaleString()

                        .mt-2

                            if notificacion.usuarioInteresadoId

                                a.btn.btn-sm.btn-primary.me-1(
                                    href='/usuarios/' + notificacion.usuarioInteresadoId
                                )
                                    | Perfil

                                a.btn.btn-sm.btn-warning.me-1(
                                    href='/mensajes/chat/' + notificacion.usuarioInteresadoId
                                )
                                    | Mensaje

                            if !notificacion.leida

                                a.btn.btn-sm.btn-success(
                                    href='/notificaciones/leida/' + notificacion.id
                                )
                                    | ✓ Leída

                            else

                                span.badge.bg-secondary
                                    | Leída