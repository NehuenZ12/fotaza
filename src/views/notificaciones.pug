extends layouts/main

block content

    h2 Notificaciones

    if notificaciones.length === 0

        p No tienes notificaciones.

    else

        each notificacion in notificaciones

            .card.mb-2

                .card-body

                    p.mb-1= notificacion.mensaje

                    small.text-muted
                        = notificacion.createdAt.toLocaleString()

                    br

                    if !notificacion.leida

                        a.btn.btn-sm.btn-success.mt-2(
                            href='/notificaciones/leida/' + notificacion.id
                        )
                            | Marcar como leída

                    else

                        span.badge.bg-secondary.mt-2
                            | Leída