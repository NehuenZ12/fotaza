extends layouts/main

block content

    h2 Mi Perfil

    p
        strong Nombre:
        |  #{usuario.nombre}

    p
        strong Correo:
        |  #{usuario.email}

    hr

    h4 Resumen

    p
        strong Publicaciones:
        |  #{publicaciones.length}

    p
        strong Seguidores:
        |  #{seguidores}

    p
        strong Seguidos:
        |  #{seguidos}

    p
        strong Colecciones:
        |  #{colecciones}

    hr

    h4 Mis últimas publicaciones

    if publicaciones.length === 0

        p No tienes publicaciones todavía.

    else

        each publicacion in publicaciones.slice(0, 5)

            -

                const imagenPublicacion =
                    imagenes.find(
                        img =>
                            img.publicacionId === publicacion.id
                    )

            .card.mb-2

                .card-body

                    if imagenPublicacion

                        img.img-thumbnail.mb-2(
                            src='/uploads/' + imagenPublicacion.ruta
                            style='max-width: 150px;'
                        )

                    h6.card-title
                        = publicacion.titulo

                    if publicacion.descripcion

                        p.card-text
                            = publicacion.descripcion

    a.btn.btn-danger.mt-3(
        href='/auth/logout'
    )
        | Cerrar sesión