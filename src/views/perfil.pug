extends layouts/main

block content

    h2.text-center.mb-4
    | Mi Perfil

    .card.mb-4

        .card-body.text-center

            h3.mb-3
                = usuario.nombre

            p.text-muted.mb-4
                = usuario.email

            .row.text-center

                .col-md-3

                    h3.text-primary.mb-0
                        = publicaciones.length

                    small.text-muted
                        | Publicaciones

                .col-md-3

                    h3.text-primary.mb-0
                        = seguidores

                    small.text-muted
                        | Seguidores

                .col-md-3

                    h3.text-primary.mb-0
                        = seguidos

                    small.text-muted
                        | Seguidos

                .col-md-3

                    h3.text-primary.mb-0
                        = colecciones

                    small.text-muted
                        | Colecciones

    if publicaciones.length === 0

        p No tienes publicaciones todavía.

    else

        each publicacion in publicaciones.slice(0, 5)

            -

                const imagenPublicacion =
                    imagenes.find(
                        img =>
                            img.publicacionId === publicacion.id
                    )

            .card.mb-2

                .card-body

                    h6.card-title
                        = publicacion.titulo

                    if publicacion.descripcion

                        p.card-text
                            = publicacion.descripcion

                    if imagenPublicacion

                        img.publicacion-img.mb-3(
                            src='/uploads/' + imagenPublicacion.ruta
                        )

    a.btn.btn-danger.mt-3(
        href='/auth/logout'
    )
        | Cerrar sesión