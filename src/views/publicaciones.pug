extends layouts/main

block content

    h2 Publicaciones

    a.btn.btn-primary.mb-3(
        href="/publicaciones/crear"
    )
        | Nueva publicación

    each publicacion in publicaciones

        .card.mb-4

            .card-body

                -
                    const imagenesPublicacion = imagenes.filter(
                        img => img.publicacionId === publicacion.id
                    )

                if imagenesPublicacion.length > 0

                    each imagen in imagenesPublicacion

                        img.img-fluid.mb-3(
                            src='/uploads/' + imagen.ruta
                            alt='Imagen'
                        )

                        form(
                            action='/denuncias/' + imagen.id
                            method='POST'
                        )

                            .mb-2

                                select.form-select(
                                    name='motivo'
                                    required
                                )

                                    option(value='')
                                        | Seleccione un motivo

                                    option(value='Contenido ofensivo')
                                        | Contenido ofensivo

                                    option(value='Violencia')
                                        | Violencia

                                    option(value='Contenido inapropiado')
                                        | Contenido inapropiado

                                    option(value='Spam')
                                        | Spam

                            .mb-2

                                textarea.form-control(
                                    name='descripcion'
                                    rows='2'
                                    placeholder='Describa el motivo de la denuncia'
                                    required
                                )

                            button.btn.btn-danger.btn-sm.mb-3(
                                type='submit'
                            )
                                | Denunciar imagen

                h5.card-title= publicacion.titulo

                p.card-text= publicacion.descripcion

                -
                    const etiquetasPublicacion = relaciones.filter(
                        relacion => relacion.publicacionId === publicacion.id
                    )

                if etiquetasPublicacion.length > 0

                    div.mt-2

                        each relacion in etiquetasPublicacion

                            -
                                const etiqueta = etiquetas.find(
                                    e => e.id === relacion.etiquetaId
                                )

                            if etiqueta

                                span.badge.bg-secondary.me-1
                                    | ##{etiqueta.nombre}

                -
                    const estadisticas =
                        estadisticasValoraciones[publicacion.id]

                .mt-2.mb-2

                    p.mb-1
                        strong Promedio:
                        |  #{estadisticas.promedio}

                    p.mb-1
                        strong Valoraciones:
                        |  #{estadisticas.cantidad}

                hr

                if publicacion.usuarioId === usuarioId

                    if publicacion.comentariosAbiertos

                        a.btn.btn-danger.btn-sm.mb-3(
                            href='/publicaciones/cerrar-comentarios/' + publicacion.id
                        )
                            | Cerrar comentarios

                    else

                        a.btn.btn-success.btn-sm.mb-3(
                            href='/publicaciones/abrir-comentarios/' + publicacion.id
                        )
                            | Abrir comentarios

                if publicacion.comentariosAbiertos

                    form(
                        action='/comentarios/crear/' + publicacion.id
                        method='POST'
                    )

                        .mb-2

                            textarea.form-control(
                                name='texto'
                                rows='2'
                                placeholder='Escribe un comentario'
                                required
                            )

                        button.btn.btn-sm.btn-primary(
                            type='submit'
                        )
                            | Comentar

                else

                    p.text-danger
                        strong Comentarios cerrados por el autor

                .mt-3

                    each comentario in comentarios

                        if comentario.publicacionId === publicacion.id

                            .border.rounded.p-2.mb-2

                                p.mb-0= comentario.texto

                hr

                form(
                    action='/valoraciones/' + publicacion.id
                    method='POST'
                )

                    .mb-2

                        label.form-label Valorar

                        select.form-select(
                            name='puntaje'
                            required
                        )

                            option(value='1') 1
                            option(value='2') 2
                            option(value='3') 3
                            option(value='4') 4
                            option(value='5') 5

                    button.btn.btn-warning.btn-sm(
                        type='submit'
                    )
                        | Enviar valoración