extends layouts/main

block content

    h2 Publicaciones

    form.mb-3(
        action="/buscar"
        method="GET"
    )

        .row

            .col-md-4

                input.form-control(
                    type="text"
                    name="etiqueta"
                    placeholder="Buscar etiqueta..."
                )

            .col-md-4

                input.form-control(
                    type="text"
                    name="texto"
                    placeholder="Titulo o descripcion..."
                )

            .col-md-2

                button.btn.btn-primary(
                    type="submit"
                )

                    img(
                        src="/img/lupa.png"
                        alt="Buscar"
                        style="width:20px;height:20px;margin-right:8px;"
                    )
                    | Buscar

    a.btn.btn-success.mb-3(
        href="/publicaciones/crear"
    )
        | Nueva publicación

    each publicacion in publicaciones

        .card.mb-4

            .card-body

                -
                    const imagenesPublicacion = imagenes.filter(
                        img => img.publicacionId === publicacion.id
                    )

                h5.card-title= publicacion.titulo
                    
                p.card-text= publicacion.descripcion

                if imagenesPublicacion.length > 0

                    each imagen in imagenesPublicacion

                        .position-relative.d-inline-block.mb-3

                            img.img-fluid.publicacion-img(
                                src='/uploads/' + imagen.ruta
                                alt='Imagen'
                            )

                            if imagen.licencia === 'copyright' && imagen.marcaagua

                                .position-absolute.top-50.start-50.translate-middle.text-white.fw-bold.opacity-50(
                                    style='font-size: 2rem; pointer-events:none;'
                                )
                                    = imagen.marcaagua                       

                        if publicacion.usuarioId !== usuarioId            

                            details.mb-3

                                summary.btn.btn-danger.btn-sm
                                    | Denunciar imagen

                                form(
                                    action='/denuncias/' + imagen.id
                                    method='POST'
                                )

                                    .mt-2

                                        select.form-select(
                                            name='motivo'
                                            required
                                        )

                                            option(value='')
                                                | Seleccione un motivo

                                            option(value='Contenido ofensivo')
                                                | Contenido ofensivo

                                            option(value='Violencia')
                                                | Violencia

                                            option(value='Contenido inapropiado')
                                                | Contenido inapropiado

                                            option(value='Spam')
                                                | Spam

                                    .mt-2

                                        textarea.form-control(
                                            name='descripcion'
                                            rows='2'
                                            placeholder='Describa el motivo de la denuncia'
                                            required
                                        )

                                    button.btn.btn-danger.btn-sm.mt-2(
                                        type='submit'
                                    )
                                        | Enviar denuncia

                -
                    const etiquetasPublicacion = relaciones.filter(
                        relacion => relacion.publicacionId === publicacion.id
                    )

                if etiquetasPublicacion.length > 0

                    div.mt-2

                        each relacion in etiquetasPublicacion

                            -
                                const etiqueta = etiquetas.find(
                                    e => e.id === relacion.etiquetaId
                                )

                            if etiqueta

                                span.badge.bg-secondary.me-1
                                    | ##{etiqueta.nombre}

                -
                    const estadisticas =
                        estadisticasValoraciones[publicacion.id]

                .mt-2.mb-2

                    p.mb-1
                        strong Promedio:
                        |  #{estadisticas.promedio}

                    p.mb-1
                        strong Valoraciones:
                        |  #{estadisticas.cantidad}

                hr

                if publicacion.usuarioId === usuarioId

                    if publicacion.comentariosAbiertos

                        a.btn.btn-danger.btn-sm.mb-3(
                            href='/publicaciones/cerrar-comentarios/' + publicacion.id
                        )
                            | Cerrar comentarios

                    else

                        a.btn.btn-success.btn-sm.mb-3(
                            href='/publicaciones/abrir-comentarios/' + publicacion.id
                        )
                            | Abrir comentarios

                if publicacion.comentariosAbiertos

                    form(
                        action='/comentarios/crear/' + publicacion.id
                        method='POST'
                    )

                        .mb-2

                            textarea.form-control(
                                name='texto'
                                rows='1'
                                placeholder='Escribe un comentario'
                                required
                            )

                        button.btn.btn-sm.btn-primary(
                            type='submit'
                        )
                            | Comentar

                else

                    p.text-danger
                        strong Comentarios cerrados por el autor
                
                hr

                details.mb-3

                    summary.btn.btn-warning
                        | Guardar en colección

                    form(
                        action='/colecciones/guardar/' + publicacion.id
                        method='POST'
                    )

                        .mt-2

                            select.form-select(
                                name='coleccionId'
                                required
                            )

                                option(value='')
                                    | Seleccione colección

                                each coleccion in colecciones

                                    option(
                                        value=coleccion.id
                                    )
                                        = coleccion.nombre

                        button.btn.btn-warning.mt-2(
                            type='submit'
                        )
                            | Guardar        

                .mt-3

                    h6 Comentarios

                    each comentario in comentarios

                        if comentario.publicacionId === publicacion.id

                            -
                                const usuarioComentario =
                                    usuarios.find(
                                        u => u.id === comentario.usuarioId
                                    )

                            .border.rounded.p-3.mb-2.bg-light

                                .d-flex.justify-content-between.align-items-start

                                    div

                                        p.mb-1

                                            strong= usuarioComentario ? usuarioComentario.nombre : 'Usuario'

                                        p.mb-0= comentario.texto

                                    if publicacion.usuarioId === usuarioId

                                        a.btn.btn-sm.btn-warning(
                                            href='/comentarios/eliminar/' + comentario.id
                                        )
                                            | Eliminar 
   
                            if comentario.usuarioId !== usuarioId      

                                details.mb-2                               

                                    summary.btn.btn-outline-danger.btn-sm
                                        | Reportar

                                    form(
                                        action='/denuncias-comentarios/' + comentario.id
                                        method='POST'
                                    )
               
                                                .mt-2

                                                    select.form-select(
                                                        name='motivo'
                                                        required
                                                    )

                                                        option(value='')
                                                            | Seleccione un motivo

                                                        option(value='Insulto')
                                                            | Insulto

                                                        option(value='Spam')
                                                            | Spam

                                                        option(value='Contenido ofensivo')
                                                            | Contenido ofensivo

                                                        option(value='Acoso')
                                                            | Acoso
                                                
                                                .mt-2

                                                    textarea.form-control(
                                                        name='descripcion'
                                                        rows='2'
                                                        placeholder='Describa el motivo de la denuncia'
                                                        required
                                                    )   

                                                button.btn.btn-danger.btn-sm.mt-2(
                                                    type='submit'
                                                )
                                                    | Enviar denuncia                                           

            hr

            if publicacion.usuarioId !== usuarioId

                .d-flex.align-items-end.gap-2.flex-wrap.mt-3

                    form(
                        action='/valoraciones/' + publicacion.id
                        method='POST'
                    )

                        .d-flex.align-items-end.gap-2

                            div

                                label.form-label.mb-1
                                    | Valorar

                                select.form-select.form-select-sm(
                                    name='puntaje'
                                    required
                                )

                                    option(value='1') 1
                                    option(value='2') 2
                                    option(value='3') 3
                                    option(value='4') 4
                                    option(value='5') 5

                            button.btn.btn-warning.btn-sm(
                                type='submit'
                            )
                                | Valorar

                    a.btn.btn-info.btn-sm(
                        href='/intereses/' + publicacion.id
                    )

                        img(
                            src='/img/corazon.png'
                            alt='Interés'
                            class='icono-boton'
                        )

                        | Me interesa