extends layouts/main

block content

    h2 Publicaciones

    a.btn.btn-primary.mb-3(
        href="/publicaciones/crear"
    )
        | Nueva publicación

    each publicacion in publicaciones

        .card.mb-4

            .card-body

                -
                    const imagen = imagenes.find(
                        img => img.publicacionId === publicacion.id
                    )

                if imagen

                    img.img-fluid.mb-3(
                        src='/uploads/' + imagen.ruta
                        alt='Imagen'
                    )

                h5.card-title= publicacion.titulo

                p.card-text= publicacion.descripcion

                -
                    const etiquetasPublicacion = relaciones.filter(
                        relacion => relacion.publicacionId === publicacion.id
                    )

                if etiquetasPublicacion.length > 0

                    div.mt-2

                        each relacion in etiquetasPublicacion

                            -
                                const etiqueta = etiquetas.find(
                                    e => e.id === relacion.etiquetaId
                                )

                            if etiqueta

                                span.badge.bg-secondary.me-1
                                    | ##{etiqueta.nombre}
                -
                    const estadisticas =
                        estadisticasValoraciones[publicacion.id]

                .mt-2.mb-2

                    p.mb-1
                        strong Promedio:
                        |  #{estadisticas.promedio}

                    p.mb-1
                        strong Valoraciones:
                        |  #{estadisticas.cantidad}

                hr

                form(
                    action='/comentarios/crear/' + publicacion.id
                    method='POST'
                )

                    .mb-2

                        textarea.form-control(
                            name='texto'
                            rows='2'
                            placeholder='Escribe un comentario'
                            required
                        )

                    button.btn.btn-sm.btn-primary(
                        type='submit'
                    )
                        | Comentar

                .mt-3

                    each comentario in comentarios

                        if comentario.publicacionId === publicacion.id

                            .border.rounded.p-2.mb-2

                                p.mb-0= comentario.texto

                                                hr

                form(
                    action='/valoraciones/' + publicacion.id
                    method='POST'
                )

                    .mb-2

                        label.form-label Valorar

                        select.form-select(
                            name='puntaje'
                            required
                        )

                            option(value='1') 1
                            option(value='2') 2
                            option(value='3') 3
                            option(value='4') 4
                            option(value='5') 5

                    button.btn.btn-warning.btn-sm(
                        type='submit'
                    )
                        | Enviar valoración