extends layouts/main

block content

    h2 Iniciar sesión

    form(action="/auth/login" method="POST")

        .mb-3

            label.form-label Correo electrónico

            input.form-control(
                type="email"
                name="email"
                required
            )

        .mb-3

            label.form-label Contraseña

            input.form-control(
                type="password"
                name="password"
                required
            )

        button.btn.btn-primary(
            type="submit"
        )
            | Ingresar

    hr

    p
        | ¿No tienes una cuenta?

    a.btn.btn-success(
        href="/auth/register"
    )
        | Registrarse