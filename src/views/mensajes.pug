extends layouts/main

block content

    h2 Conversaciones

    if conversaciones.length === 0

        p No tienes conversaciones.

    else

        each conversacion in conversaciones

            -
                const usuario =
                    usuarios.find(
                        u => u.id === conversacion.usuarioId
                    )

            .card.mb-3

                .card-body

                    h5.card-title
                        = usuario ? usuario.nombre : 'Usuario'

                    p.text-muted
                        = conversacion.ultimoMensaje

                    a.btn.btn-primary(
                        href='/mensajes/chat/' + conversacion.usuarioId
                    )
                        | Abrir conversación