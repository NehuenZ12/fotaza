extends layouts/main

block content

    h2 Conversaciones

    each mensaje in mensajes

        -
            const remitente =
                usuarios.find(
                    u => u.id === mensaje.remitenteId
                )

        -
            const destinatario =
                usuarios.find(
                    u => u.id === mensaje.destinatarioId
                )

        .card.mb-3

            .card-body

                p
                    strong De:
                    |  #{remitente ? remitente.nombre : 'Usuario'}

                p
                    strong Para:
                    |  #{destinatario ? destinatario.nombre : 'Usuario'}

                p= mensaje.texto

                if mensaje.remitenteId !== usuarioId

                    form(
                        action='/mensajes/enviar/' + mensaje.remitenteId
                        method='POST'
                    )

                        .mb-2

                            textarea.form-control(
                                name='texto'
                                rows='2'
                                placeholder='Responder mensaje'
                                required
                            )

                        button.btn.btn-primary.btn-sm(
                            type='submit'
                        )
                            | Responder