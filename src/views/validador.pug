extends layouts/main

block content

    h2 Publicaciones en revisión

    if publicaciones.length === 0

        .card

            .card-body.text-center

                h4.text-success
                    | ✓ No hay publicaciones pendientes

                p.mb-0
                    | Todas las denuncias han sido resueltas.

    else

        each publicacion in publicaciones

            -
                const autor =
                    usuarios.find(
                        u => u.id === publicacion.usuarioId
                    )

            .card.mb-3

                .card-body

                    h4.card-title
                        = publicacion.titulo

                    if autor

                        p.text-muted.mb-2
                            strong Autor:
                            |  #{autor.nombre}

                    if publicacion.descripcion

                        p.card-text
                            = publicacion.descripcion

                    -
                        const imagen =
                            imagenes.find(
                                img =>
                                    img.publicacionId === publicacion.id
                            )

                    if imagen

                        img.publicacion-seguido-img.mb-3(
                            src=imagen.ruta.startsWith('http')
                                ? imagen.ruta
                                : '/uploads/' + imagen.ruta
                            alt='Imagen'
                        )

                    hr

                    a.btn.btn-success.me-2(
                        href='/validador/desestimar/' + publicacion.id
                    )
                        | Desestimar denuncias

                    a.btn.btn-danger(
                        href='/validador/baja/' + publicacion.id
                    )
                        | Dar de baja publicación