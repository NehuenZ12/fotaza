extends layouts/main

block content

    h2= coleccion.nombre

    hr

    if publicaciones.length === 0

        p No hay publicaciones guardadas.

    else

        each publicacion in publicaciones

            .card.mb-3

                .card-body

                    -
                        const imagen =
                            imagenes.find(
                                img =>
                                    img.publicacionId ===
                                    publicacion.id
                            )

                    if imagen

                        img.img-fluid.mb-3(
                            src=imagen.ruta.startsWith('http')
                                ? imagen.ruta
                                : '/uploads/' + imagen.ruta
                            alt='Imagen'
                        )

                    h5.card-title= publicacion.titulo

                    p.card-text= publicacion.descripcion