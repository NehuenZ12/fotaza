extends layouts/main

block content

    h2 Ranking de publicaciones

    table.table.table-striped

        thead

            tr

                th Posición
                th Título
                th Promedio
                th Cantidad de votos

        tbody

            each item, index in ranking

                tr

                    td= index + 1

                    td= item.publicacion.titulo

                    td= item.promedio.toFixed(1)

                    td= item.cantidad