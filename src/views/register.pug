extends layouts/main

block content

    h2 Registro de usuario

    form(action="/auth/register" method="POST")

        .mb-3
            label.form-label Nombre
            input.form-control(
                type="text"
                name="nombre"
                required
            )

        .mb-3
            label.form-label Correo electrónico
            input.form-control(
                type="email"
                name="email"
                required
            )

        .mb-3
            label.form-label Contraseña
            input.form-control(
                type="password"
                name="password"
                required
            )

        button.btn.btn-success(type="submit")
            | Registrarse