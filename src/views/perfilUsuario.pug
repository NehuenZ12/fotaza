extends layouts/main

block content

    h2 Perfil de #{usuario.nombre}

    .card.mb-4

        .card-body

            p
                strong Email:
                |  #{usuario.email}

            hr

            h5 Resumen

            .row.text-center.mt-4

                .col-md-4

                    h3.mb-0.text-primary
                        = seguidores

                    small.text-muted
                        | Seguidores

                .col-md-4

                    h3.mb-0.text-primary
                        = seguidos

                    small.text-muted
                        | Siguiendo

                .col-md-4

                    h3.mb-0.text-primary
                        = publicaciones.length

                    small.text-muted
                        | Publicaciones

    h4 Últimas publicaciones

    if publicaciones.length === 0

        p Este usuario no tiene publicaciones.

    else

        each publicacion in publicaciones

            .card.mb-3

                .card-body

                    -
                        const imagen =
                            imagenes.find(
                                img =>
                                    img.publicacionId ===
                                    publicacion.id
                            )

                    if imagen

                        img.img-fluid.publicacion-img.mb-3(
                            src='/uploads/' + imagen.ruta
                            alt='Imagen'
                        )

                    h5.card-title
                        = publicacion.titulo

                    if publicacion.descripcion

                        p.card-text
                            = publicacion.descripcion